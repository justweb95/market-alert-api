generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  IOS
  ANDROID
  WEB
}

enum PlanTier {
  FREE
  BRONZE
  SILVER
  GOLD
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

model User {
  id                        String    @id @default(cuid())
  firstName                 String
  lastName                  String
  email                     String    @unique
  passwordHash              String
  googleId                  String?   @unique
  planTier                  PlanTier  @default(FREE)
  promoCodeUsed             String?
  promoRedeemedAt           DateTime?
  trialStartedAt            DateTime?
  emailVerified             Boolean   @default(false)
  emailVerifyToken          String?   @unique
  emailVerifyTokenExpiresAt DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  devices      Device[]
  subscription Subscription?
}

model Subscription {
  id           String             @id @default(cuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier         PlanTier
  status       SubscriptionStatus @default(ACTIVE)
  revenuecatId String?
  productId    String?
  startedAt    DateTime           @default(now())
  renewsAt     DateTime?
  pausedAt     DateTime?
  cancelledAt  DateTime?
  updatedAt    DateTime           @updatedAt

  @@index([revenuecatId])
}

model Device {
  id             String   @id @default(cuid())
  expoPushToken  String   @unique
  platform       Platform
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  trialStartedAt DateTime?
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @updatedAt

  alerts        Alert[]
  notifications Notification[]

  @@index([userId])
}

model Alert {
  id       String @id @default(cuid())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  category     String
  locationText String
  priceMax     Int?
  keywords     String[]
  propertyType String?
  yearFrom     Int?
  yearTo       Int?
  kmFrom       Int?
  kmTo         Int?
  // Filteri za vozila. Prazan niz = "nije bitno" (bez filtriranja).
  // fuelTypes:  BENZIN, DIZEL, HIBRID, ELEKTRO, TNG, CNG
  // bodyTypes:  LIMUZINA, HECBEK, KARAVAN, SUV, KUPE, KABRIOLET, MONOVOLUMEN, PIKAP, KOMBI
  fuelTypes    String[]
  bodyTypes    String[]
  // Moto filteri: motoTypes = NAKED, SPORT, CHOPPER, ENDURO, SKUTER, TURING, ATV, KLASIK
  motoTypes    String[]
  // Regioni Srbije (BEOGRAD, VOJVODINA, ZAPADNA, ISTOCNA, JUZNA, KOSOVO).
  // Prazan niz = cela Srbija.
  regions      String[]
  ccmFrom      Int?
  ccmTo        Int?
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notificationLogs NotificationLog[]

  @@index([deviceId])
  @@index([isActive])
  @@index([category])
  @@index([isActive, category])
  @@index([createdAt])
}

model Listing {
  id           String    @id @default(cuid())
  source       String
  externalId   String
  title        String
  price        Float?
  locationText String?
  url          String
  postedAt     DateTime?
  raw          Json?
  createdAt    DateTime  @default(now())

  notificationLogs NotificationLog[]

  @@unique([source, externalId])
  @@index([createdAt])
}

model NotificationLog {
  id      String @id @default(cuid())
  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  sentAt DateTime @default(now())

  @@unique([alertId, listingId])
  @@index([sentAt])
}

model Notification {
  id        String @id @default(cuid())
  deviceId  String
  device    Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  title     String
  body      String
  data      Json?             @default("{}")
  status    NotificationStatus @default(PENDING)
  retries   Int               @default(0)
  lastError String?
  sentAt    DateTime?
  failedAt  DateTime?

  listingId String?
  alertId   String?

  createdAt DateTime @default(now())
  seenAt    DateTime?

  @@index([deviceId, status])
  @@index([alertId])
  @@index([listingId])
  @@index([alertId, listingId])
  @@index([createdAt])
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SEEN
}

model ScrapeRun {
  id           String   @id @default(cuid())
  source       String
  success      Boolean
  itemCount    Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
